# Grocera Production Environment Template

# PostgreSQL Configuration
POSTGRES_USER=grocera
POSTGRES_PASSWORD=strong_production_password
POSTGRES_DB=grocera_prod
DOCKER_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# Local/Dev Database URL (if running locally without docker)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public

# Security
JWT_SECRET=generate_a_long_random_string_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=generate_another_long_random_string_here
REFRESH_TOKEN_EXPIRES_IN=7d

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=https://api.grocera.com/v1

# Scraper Concurrency settings
MAX_CONCURRENT_SCRAPES=5

# Gemini models are tried in order. Use stable models that support text,
# structured outputs, and function calling.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# Application logs are written to this directory relative to the backend process.
LOG_DIRECTORY=logs

# Default Admin Settings (Used during DB Seed)
ADMIN_EMAIL=admin@grocera.com
ADMIN_PASSWORD=password123
# Optional dedicated password for the queue dashboard. Falls back to ADMIN_PASSWORD.
BULL_BOARD_PASSWORD=use_a_strong_separate_password

# Development demo login (created by `npx prisma db seed`)
# Email: demo.consumer@grocera.test
# Password: Demo12345!

FRONTEND_URL=https://www.grocera.com
